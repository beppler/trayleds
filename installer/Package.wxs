<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="TrayLeds"
           Manufacturer="Carlos Alberto Costa Beppler"
           Version="$(var.ProductVersion)"
           UpgradeCode="{7525D841-D2DB-4F0B-A05A-F7A60933D06A}"
           Scope="perUser"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="TrayLeds.ico" SourceFile="..\src\TrayLeds\Resources\N1C1S1.ico" />
    <Property Id="ARPPRODUCTICON" Value="TrayLeds.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/beppler/trayleds" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="TrayLeds" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Guid="{37A18AD9-837B-41BB-9F1E-F5759A583D37}">
        <!-- The Run value is the key path (ICE38: a file under the user profile cannot be). It starts TrayLeds at
             every logon of the installing user and goes away with the component on uninstall.
             The Guid is explicit because WiX cannot autogenerate one for a component mixing a file and a registry
             key path (WIX0230); it must never change. -->
        <File Id="TrayLedsExe" Source="$(var.PublishDir)TrayLeds.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="TrayLeds"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]TrayLeds.exe&quot;"
                       KeyPath="yes" />
        <!-- ICE64: every profile folder the package creates must be removed on uninstall (only when empty). -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Sends WM_CLOSE and waits (up to 5 s) for TrayLeds to exit. TrayLeds handles WM_CLOSE with Dispose(),
         removing its tray icon. A hard kill would leave a ghost icon. No ElevatedCloseMessage and RebootPrompt off (it defaults to on): either
         one makes util queue a deferred action, which cannot run before InstallInitialize (error 2762). -->
    <util:CloseApplication Id="CloseTrayLeds"
                           Target="TrayLeds.exe"
                           CloseMessage="yes"
                           RebootPrompt="no" />

    <!-- Starts the installed TrayLeds as the installing user so the icon shows up without logging off. -->
    <CustomAction Id="LaunchTrayLeds" FileRef="TrayLedsExe" ExeCommand=""
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- Not on repair or uninstall (Installed). A major upgrade still launches the new version, since the old
           instance was closed by CloseApplication. -->
      <Custom Action="LaunchTrayLeds" After="InstallFinalize" Condition="NOT Installed" />
      <!-- Close TrayLeds before Restart Manager checks files in use during InstallValidate; otherwise it reports
           TrayLeds.exe as in use and asks for a reboot before any close attempt runs. -->
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Before="InstallValidate" Condition="VersionNT &gt; 400" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

  </Package>
</Wix>
